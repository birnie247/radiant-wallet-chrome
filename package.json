{
  "name": "rxd-wallet-extension",
  "version": "1.0.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Non-custodial Radiant (RXD) wallet as a Chrome extension",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/stamp-manifest.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/build-extension-icons.mjs",
    "check:browser": "vite build -c vite.test.config.ts && node dist-test/browser-path-check.js",
    "check:csp": "node scripts/check-csp.mjs",
    "check:extension": "node scripts/check-extension.mjs",
    "check": "npm run typecheck && npm run check:browser && npm run build && npm run check:csp && npm run check:extension",
    "publish:release": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radiant-core/radiantjs": "^2.0.6",
    "@radiant-core/sdk": "^0.2.1",
    "buffer": "^6.0.3",
    "js-sha512": "^0.8.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "ws": "^8.22.1"
  }
}
